{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/ticket/assets/:path*",
      "destination": "https://dmap-50136.web.app/assets/:path*"
    },
    {
      "source": "/ticket/hubpas-icon.svg",
      "destination": "https://dmap-50136.web.app/hubpas-icon.svg"
    },
    {
      "source": "/ticket/manifest.json",
      "destination": "https://dmap-50136.web.app/manifest.json"
    },
    {
      "source": "/ticket/:shareId",
      "destination": "https://dmap-50136.web.app/ticket/:shareId"
    },
    {
      "source": "/api/site-metrics",
      "destination": "https://us-central1-dmap-50136.cloudfunctions.net/hubpasSiteMetrics"
    },
    {
      "source": "/api/featured-events",
      "destination": "https://us-central1-dmap-50136.cloudfunctions.net/hubpasFeaturedEvents"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://us-central1-dmap-50136.cloudfunctions.net/hubpasAdminApi/api/admin/:path*"
    }
  ],
  "headers": [
    {
      "source": "/ticket/:path*",
      "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
    }
  ]
}
